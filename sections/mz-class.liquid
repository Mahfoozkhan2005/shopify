<style>
h1 {
    padding-top: {{ section.settings.padding_top }}rem;
    padding-bottom: {{ section.settings.padding_bottom }}rem;
    font-size: {{ section.settings.haddingfont_size }}px;
}
</style>

<div class="page-width">
    {{ section.settings.radio }}
    {% if section.settings.show_heading %}
        <h1 style="text-align: {{ section.settings.heading_alignment }};">
            {{ section.settings.heading_text }}
        </h1>
    {% endif %}
    
    <p>{{ section.settings.paragraph }}</p>
    
    {% if section.settings.number > 0 %}
       {{ section.settings.number }} 
       <!-- Logic: agar 0 se chhota ho to show nahi karna, agar 0 se bada ho to show karna -->
    {% endif %}
</div>

{% schema %}
{
    "name": "class1",
    "settings": [
        {
            "type": "text",
            "id": "heading_text",
            "label": "Heading"
        },
        {
            "type": "textarea",
            "id": "paragraph",
            "label": "Write paragraph"
        },
        {
            "type": "number",
            "id": "number",
            "label": "Number",
            "default": 122
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding top",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "rem",
            "default": 2
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding bottom",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "rem",
            "default": 2
        },
        {
            "type": "range",
            "id": "haddingfont_size",
            "label": "Heading font size",
            "min": 1,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "select",
            "id": "heading_alignment",
            "label": "Heading alignment",
            "options": [
                {
                    "value": "left",
                    "label": "Left align"
                },
                {
                    "value": "center",
                    "label": "Center align"
                }
            ]
        },
        {
            "type": "checkbox",
            "id": "show_heading",
            "label": "Show heading",
            "default": true
        },
        {
            "type": "radio",
            "id": "radio",
            "label": "Radio choice",
            "options": [
                {
                    "value": "this video is good",
                    "label": "Good"
                },
                {
                    "value": "this is bad",
                    "label": "Bad"
                }
            ]
        }
    ],
    "blocks": [],
    "presets": [
        {
            "name": "class1"
        }
    ]
}
{% endschema %}    
<section style="background: {{ section.settings.bg_color }};">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
  {% render 'button', label: 'Shop Now', link: '/collections/all' %}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Main Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "color", "id": "bg_color", "label": "Background Color" }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
